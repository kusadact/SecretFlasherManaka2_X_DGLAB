<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SecretFlasherManakaCoyoteLink</AssemblyName>
    <RootNamespace>SecretFlasherManakaCoyoteLink</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <OutputPath>$(MSBuildProjectDirectory)\dist\</OutputPath>
    <IntermediateOutputPath>$(MSBuildProjectDirectory)\obj\$(Configuration)\</IntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!--
      These properties must point to the local game installation. They are
      intentionally not hard-coded to this repository's release directory.
      build.ps1 supplies them when it invokes dotnet build.
    -->
    <GameDir Condition="'$(GameDir)' == '' and '$(SECRET_FLASHER_MANAKA_GAME_DIR)' != ''">$(SECRET_FLASHER_MANAKA_GAME_DIR)</GameDir>
    <BepInExDir Condition="'$(BepInExDir)' == '' and '$(GameDir)' != ''">$(GameDir)\BepInEx</BepInExDir>
    <DotnetDir Condition="'$(DotnetDir)' == '' and '$(GameDir)' != ''">$(GameDir)\dotnet</DotnetDir>
    <CoreDir Condition="'$(CoreDir)' == '' and '$(BepInExDir)' != ''">$(BepInExDir)\core</CoreDir>
    <InteropDir Condition="'$(InteropDir)' == '' and '$(BepInExDir)' != ''">$(BepInExDir)\interop</InteropDir>
    <UnityLibDir Condition="'$(UnityLibDir)' == '' and '$(BepInExDir)' != ''">$(BepInExDir)\unity-libs</UnityLibDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\Plugin.cs" />
  </ItemGroup>

  <!-- .NET 6 runtime assemblies shipped with the IL2CPP game loader. -->
  <ItemGroup Condition="'$(DotnetDir)' != ''">
    <Reference Include="System.Private.CoreLib">
      <HintPath>$(DotnetDir)\System.Private.CoreLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>$(DotnetDir)\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Runtime">
      <HintPath>$(DotnetDir)\System.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Runtime.Extensions">
      <HintPath>$(DotnetDir)\System.Runtime.Extensions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Runtime.InteropServices">
      <HintPath>$(DotnetDir)\System.Runtime.InteropServices.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Collections">
      <HintPath>$(DotnetDir)\System.Collections.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Console">
      <HintPath>$(DotnetDir)\System.Console.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Globalization">
      <HintPath>$(DotnetDir)\System.Globalization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Private.Uri">
      <HintPath>$(DotnetDir)\System.Private.Uri.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Net.Primitives">
      <HintPath>$(DotnetDir)\System.Net.Primitives.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Net.Sockets">
      <HintPath>$(DotnetDir)\System.Net.Sockets.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Net.WebSockets">
      <HintPath>$(DotnetDir)\System.Net.WebSockets.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Net.WebSockets.Client">
      <HintPath>$(DotnetDir)\System.Net.WebSockets.Client.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Text.Encoding">
      <HintPath>$(DotnetDir)\System.Text.Encoding.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Threading">
      <HintPath>$(DotnetDir)\System.Threading.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Threading.Tasks">
      <HintPath>$(DotnetDir)\System.Threading.Tasks.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(CoreDir)' != ''">
    <Reference Include="BepInEx.Core">
      <HintPath>$(CoreDir)\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.Common">
      <HintPath>$(CoreDir)\BepInEx.Unity.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(CoreDir)\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(CoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(CoreDir)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(InteropDir)' != ''">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(InteropDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(InteropDir)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(UnityLibDir)' != ''">
    <Reference Include="UnityEngine">
      <HintPath>$(UnityLibDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityLibDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(UnityLibDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PluginReference Include="$(DotnetDir)\System.Private.CoreLib.dll" />
    <PluginReference Include="$(DotnetDir)\netstandard.dll" />
    <PluginReference Include="$(DotnetDir)\System.Runtime.dll" />
    <PluginReference Include="$(DotnetDir)\System.Runtime.Extensions.dll" />
    <PluginReference Include="$(DotnetDir)\System.Runtime.InteropServices.dll" />
    <PluginReference Include="$(DotnetDir)\System.Collections.dll" />
    <PluginReference Include="$(DotnetDir)\System.Console.dll" />
    <PluginReference Include="$(DotnetDir)\System.Globalization.dll" />
    <PluginReference Include="$(DotnetDir)\System.Private.Uri.dll" />
    <PluginReference Include="$(DotnetDir)\System.Net.Primitives.dll" />
    <PluginReference Include="$(DotnetDir)\System.Net.Sockets.dll" />
    <PluginReference Include="$(DotnetDir)\System.Net.WebSockets.dll" />
    <PluginReference Include="$(DotnetDir)\System.Net.WebSockets.Client.dll" />
    <PluginReference Include="$(DotnetDir)\System.Text.Encoding.dll" />
    <PluginReference Include="$(DotnetDir)\System.Threading.dll" />
    <PluginReference Include="$(DotnetDir)\System.Threading.Tasks.dll" />
    <PluginReference Include="$(CoreDir)\BepInEx.Core.dll" />
    <PluginReference Include="$(CoreDir)\BepInEx.Unity.Common.dll" />
    <PluginReference Include="$(CoreDir)\BepInEx.Unity.IL2CPP.dll" />
    <PluginReference Include="$(CoreDir)\0Harmony.dll" />
    <PluginReference Include="$(CoreDir)\Il2CppInterop.Runtime.dll" />
    <PluginReference Include="$(InteropDir)\Assembly-CSharp.dll" />
    <PluginReference Include="$(InteropDir)\Il2Cppmscorlib.dll" />
    <PluginReference Include="$(UnityLibDir)\UnityEngine.dll" />
    <PluginReference Include="$(UnityLibDir)\UnityEngine.CoreModule.dll" />
    <PluginReference Include="$(UnityLibDir)\UnityEngine.InputLegacyModule.dll" />
  </ItemGroup>

  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameDir)' == ''" Text="GameDir is required. Run plugin\build.ps1 -GameDir &quot;C:\path\to\SecretFlasherManaka v1.1.3&quot;." />
    <Error Condition="'$(BepInExDir)' == ''" Text="BepInExDir could not be resolved from GameDir." />
    <Error Condition="!Exists('%(PluginReference.Identity)')" Text="Game reference not found: %(PluginReference.Identity)" />
  </Target>
</Project>
